# Development-only defaults. Store production secrets in a secret manager.
POSTGRES_DB=centralchat
POSTGRES_USER=centralchat
POSTGRES_PASSWORD=centralchat_dev
RABBITMQ_USER=centralchat
RABBITMQ_PASSWORD=centralchat_dev
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
META_VERIFY_TOKEN=replace-with-meta-webhook-verification-token
META_APP_SECRET=replace-with-meta-app-secret
META_ACCESS_TOKEN=replace-with-meta-system-user-token
META_VALIDATE_SIGNATURE=false
META_USE_DEVELOPMENT_CLIENT=true
NEXT_PUBLIC_API_URL=http://localhost:8080
